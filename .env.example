# Server (Cloud Run sets PORT automatically; default 8080 in container)
PORT=3000

# PostgreSQL database connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=stocktalk

# Cloud SQL only (Cloud Run): PROJECT_ID:REGION:INSTANCE_NAME
# When set, DB_HOST/DB_PORT are ignored and the Unix socket is used.
# INSTANCE_CONNECTION_NAME=

# Set to true only in development. It auto-creates tables from entities.
DB_SYNCHRONIZE=true

# Firebase Admin uses Application Default Credentials (ADC).
# Local: export GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
# Cloud Run: the runtime service account is used automatically.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Google Cloud Storage (direct image uploads from Android). Uses ADC.
GCS_BUCKET_NAME=your-gcs-bucket-name
